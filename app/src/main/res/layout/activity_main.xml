<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/main" android:fillViewport="true" android:background="@drawable/mf_screen">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Мои финансы" android:textSize="25sp" android:textColor="#F8F3EA" android:textStyle="bold" android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⋮" android:textColor="#F1CD86" android:textSize="24sp" android:contentDescription="Меню"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mf_balance" android:padding="14dp" android:layout_marginBottom="9dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Общий баланс" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 ₽" android:textSize="32sp" android:textColor="#F8F3EA" android:textStyle="bold" android:id="@+id/balance_total"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RUB" android:textSize="13sp" android:textColor="#F1CD86" android:paddingTop="10dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/mf_card" android:padding="3dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:background="@drawable/mf_gold" android:layout_weight="1" android:gravity="center" android:id="@+id/income_total_action" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Доходы  +0 ₽" android:textSize="13sp" android:textColor="#251807" android:textStyle="bold" android:gravity="center" android:id="@+id/income_total"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/expense_total_action" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Расходы  −0 ₽" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:gravity="center" android:id="@+id/expense_total"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/mf_card" android:padding="3dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:background="@drawable/mf_gold" android:layout_weight="1" android:gravity="center" android:id="@+id/add_operation" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Добавить" android:textSize="13sp" android:textColor="#251807" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Перевод" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Долги" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Счета" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="История операций" android:textSize="13sp" android:textColor="#BDB6AB" android:textStyle="bold" android:paddingBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/operation_history"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Главная     ·     Аналитика     ·     Счета" android:textSize="13sp" android:textColor="#F1CD86" android:textStyle="bold" android:gravity="center" android:padding="12dp"/>
    </LinearLayout>
</ScrollView>
